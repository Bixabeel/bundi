# ABUNDIA.IO — Cloudflare Pages response headers
# Security policies are preserved and the current site assets were checked.
# Cloudflare Pages applies this file to static asset responses. The RSS API
# route is served by its own Worker and keeps the headers defined in that code.
#
# CSP decisions:
# - style-src keeps 'unsafe-inline' because multiple existing HTML pages use
#   inline style attributes and style blocks. Removing it would break layouts.
# - script-src does NOT use 'unsafe-inline'. The inline price calculator in
#   /precios/precios.html is authorized by its exact SHA-256 hash below.
# - The application/ld+json block in proyectos/eterna.html is structured-data
#   content, not executable JavaScript, so it does not need a script hash.
# - Two inline onerror attributes found in proyectos/open-eye.html were
#   removed; all executable scripts are now local files or the hash below.
# - connect-src permits same-origin RSS requests and Web3Forms submissions.
# - The site uses Google Fonts, so their stylesheet and font hosts stay allowed.
#
# Cache decisions:
# CSS and JS filenames are not fingerprinted, so they must revalidate.
# Images use a short freshness window rather than a year-long immutable cache.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: on
  X-Permitted-Cross-Domain-Policies: none
  X-Download-Options: noopen
  Origin-Agent-Cluster: ?1
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: unsafe-none
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-2JC+hzX9U7v7oo1FtLG8K4mNcPx1TJBXENH6NqnGULg='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-src 'none'; object-src 'none'; base-uri 'self'; manifest-src 'self'; worker-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; block-all-mixed-content

# Pages that must not appear in search results. Keep them crawlable so bots
# can see the noindex instruction in the response/header and document markup.
/404.html
  X-Robots-Tag: noindex, follow

/gracias/
  X-Robots-Tag: noindex, nofollow

/legal/*.html
  X-Robots-Tag: noindex, follow

# Worker source and test assets are kept in the repository for maintenance;
# they are not search landing pages.
/workers/*
  X-Robots-Tag: noindex, nofollow

# Cloudflare Pages production and branch-preview hostnames must not compete
# with the canonical https://abundia.io/ property in search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Revalidate HTML so deployments are visible without a long browser cache.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/gracias/
  Cache-Control: public, max-age=0, must-revalidate

/legal/
  Cache-Control: public, max-age=0, must-revalidate

/precios
  Cache-Control: public, max-age=0, must-revalidate

# These filenames are not content-hashed; revalidate CSS and JavaScript.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Images change less frequently, but are not fingerprinted either.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
